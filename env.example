# Application
PORT=3000

# Database (MongoDB)
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DB_NAME="freight-team-db"

# Authentication (JWT)
JWT_SECRET="change_me"
JWT_EXPIRES_IN="24h"

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/redirect"

# Facebook OAuth
FACEBOOK_CLIENT_ID="your_facebook_client_id"
FACEBOOK_CLIENT_SECRET="your_facebook_client_secret"
FACEBOOK_CALLBACK_URL="http://localhost:3000/auth/facebook/redirect"

# Mailer (Resend)
RESEND_API_KEY="re_xxxxxxxx"
MAIL_FROM="Freight Team <noreply@yourdomain.com>"

# OpenAI (BOL PDF parsing)
OPENAI_API_KEY="sk-xxxxxxxx"

# Google Sheets sync
GOOGLE_SHEETS_SPREADSHEET_ID="your_spreadsheet_id"
# Shared secret the Apps Script webhook must send back (X-Webhook-Secret header
# or a "secret" field in the payload). Leave unset to allow unauthenticated
# webhook calls (not recommended once the Sheet carries customer info).
GOOGLE_SHEETS_WEBHOOK_SECRET="change_me"

# # Redis (for BullMQ)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASS="your_redis_password"